---
import { SITE } from '../config';
import SpecStrip from './SpecStrip.astro';

const year = new Date().getFullYear();
---

<footer class="shell colophon">
  <SpecStrip />
  <div class="colophon__meta">
    <p>© {year} {SITE.name}</p>
    <p>
      <a href="/rss.xml">RSS</a> · <a href="/sitemap/">Sitemap</a>
    </p>
    <p>Astro · No JavaScript · No web fonts</p>
  </div>
</footer>
