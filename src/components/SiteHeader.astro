---
import { NAV, SITE } from '../config';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="rack">
  <div class="rack__bar">
    <a class="rack__mark" href="/">
      {/*
        アイコンは唯一の外部サブリソース。読み込みが 1 つ増えるので、
        読み取り値の request も 1 → 2 になる。1 に戻したいときは画像を
        data URI にして config の avatar に直接書く（README を見る）。
      */}
      <img
        class="rack__face"
        src={SITE.avatar}
        width="32"
        height="32"
        alt="Home"
        decoding="async"
        fetchpriority="high"
      />
      <!-- <span>{SITE.name}</span> -->
    </a>

    {/* 開閉は details / summary。JS を 1 バイトも足さずにキーボードでも操作できる。 */}
    <details class="menu">
      <summary>
        <span class="menu__glyph"></span>
        <span class="visually-hidden">メニュー</span>
      </summary>
      <nav class="nav" aria-label="サイト内">
        {
          NAV.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>
