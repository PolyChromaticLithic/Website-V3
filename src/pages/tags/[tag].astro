---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import PostRow from '../../components/PostRow.astro';
import Base from '../../layouts/Base.astro';
import { tagSlug } from '../../lib/tags';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

  // 別のタグが同じ URL に落ちたら、片方のページが黙って消える。ビルドを止めて知らせる。
  const bySlug = new Map<string, string>();
  for (const tag of tags) {
    const slug = tagSlug(tag);
    const clash = bySlug.get(slug);
    if (clash)
      throw new Error(`タグ "${clash}" と "${tag}" が同じ URL (/tags/${slug}/) になります`);
    bySlug.set(slug, tag);
  }

  return tags.map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: {
      tag,
      posts: posts
        .filter((post) => post.data.tags.includes(tag))
        .sort((a, b) => b.data.published.getTime() - a.data.published.getTime()),
    },
  }));
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props;

/* パンくずの末尾はタグ名をそのまま出す。slug からの既定は語頭を大文字にするので、
   css が Css になって別の語に見えてしまう。 */
---

<Base title={`${tag} の記事`} description={`${tag} タグの付いた記事の一覧。`} crumb={tag}>
  <section class="shell page-head">
    <p class="mono muted">Tag</p>
    <h1 class="display page-head__title">{tag}</h1>
    <p class="mono muted follow">{posts.length} 件</p>
  </section>

  <div class="shell blocks">
    <section class="block">
      <h2 class="block__label">Posts</h2>
      <div class="rows">
        {posts.map((post) => <PostRow post={post} />)}
      </div>
    </section>
  </div>
</Base>
