---
import { getCollection } from 'astro:content';
import PostRow from '../components/PostRow.astro';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime())
  .slice(0, 4);

const works = (await getCollection('works', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
);
---

<Base>
  <section class="shell hero">
    <p class="mono muted">Index</p>
    <h1 class="display hero__title">Astarの素敵なホームページ V3</h1>
    <p class="hero__tagline">
      UnityとかC#とかをやってます
    </p>
  </section>

  <div class="shell blocks">
    <section class="block">
      <h2 class="block__label">Writing</h2>
      <div>
        {
          posts.length > 0 ? (
            <div class="rows">
              {posts.map((post) => (
                <PostRow post={post} />
              ))}
            </div>
          ) : (
            <p class="empty">
              <b>まだ記事がありません</b>
            </p>
          )
        }
        {
          posts.length > 0 && (
            <p class="mono muted follow">
              <a href="/blog/">記事をすべて見る →</a>
            </p>
          )
        }
      </div>
    </section>

    <section class="block">
      <h2 class="block__label">Works</h2>
      <div>
        {
          works.length > 0 ? (
            <div class="rows">
              {works.map((work) => (
                <a class="row" href={`/works/${work.id}/`}>
                  <span class="row__date">{work.data.year}</span>
                  <div>
                    <span class="row__title">{work.data.title}</span>
                    <p class="row__summary">{work.data.summary}</p>
                  </div>
                  <span class="row__meta">
                    {work.data.stack.map((item) => (
                      <span class="tag">{item}</span>
                    ))}
                  </span>
                </a>
              ))}
            </div>
          ) : (
            <p class="empty">
              <b>公開できる作品がまだありません</b>
            </p>
          )
        }
      </div>
    </section>

    <section class="block">
      <h2 class="block__label">Contact</h2>
      <div class="stack">
        <p class="limit">ご連絡は以下までお願いします。</p>
        <p class="mono">
          <a href="mailto:polychromaticlithic@outlook.jp">polychromaticlithic@outlook.jp</a>
        </p>
        <p class="limit">その他ソーシャルメディア：</p>
        <p class="mono">
          <a href="https://twitter.com/PolyChromaticLi" target="_blank" rel="noopener noreferrer">Twitter</a>
          <a href="https://github.com/PolyChromaticLithic" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="https://misskey.io/@As6" target="_blank" rel="noopener noreferrer">Misskey</a>
        </p>
      </div>
    </section>
  </div>
</Base>
