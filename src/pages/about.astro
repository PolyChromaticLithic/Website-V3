---
import { SITE } from '../config';
import Base from '../layouts/Base.astro';

/** 技術スタック。段ごとに並べる。順番はそのまま表示の順番。 */
const STACK = [
  { name: '得意！', items: ['Unity', 'C#'] },
  {
    name: 'まあまあ',
    items: [
      'C',
      'Python',
      'Java',
      'Spring',
      'HTML/CSS',
      'Next.js',
      'Blender',
      'TypeScript',
      'Git',
      'Vim',
      'PHP',
      'SQL',
      'Supabase',
      'MongoDB',
    ],
  },
  { name: 'ちょっと', items: ['Docker', '電子工作', '作曲(Studio One)', 'イラスト'] },
];
---

<Base title="About" description={`${SITE.name} について。`}>
  <section class="shell page-head">
    <p class="mono muted">About</p>
    <h1 class="display page-head__title">Astarについて</h1>
  </section>

  <div class="shell blocks">
    <section class="block">
      <p class="block__label">Profile</p>
      <div class="prose">
        <p>
          高専生です。UnityとC#が好物です。Web製作とかもやります。
        </p>
      </div>
    </section>

    <section class="block">
      <p class="block__label">Stack</p>
      <div class="tiers">
        {
          STACK.map((tier) => (
            <div class:list=['tier']>
              <p class="tier__name">{tier.name}</p>
              <ul class="tier__list">
                {tier.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="block">
      <h2 class="block__label">Contact</h2>
      <div class="stack">
        <div class="stack stack--tight">
          <p class="limit">ご連絡は以下までお願いします。</p>
          <p class="mono">
            <a href="mailto:polychromaticlithic@outlook.jp">polychromaticlithic@outlook.jp</a>
          </p>
        </div>
        <div class="stack stack--tight">
          <p class="limit">その他ソーシャルメディア：</p>
          <p class="mono">
            <a href="https://twitter.com/PolyChromaticLi" target="_blank" rel="noopener noreferrer">Twitter</a>
            <a href="https://github.com/PolyChromaticLithic" target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href="https://misskey.io/@As6" target="_blank" rel="noopener noreferrer">Misskey</a>
          </p>
        </div>
      </div>
    </section>
  </div>
</Base>
