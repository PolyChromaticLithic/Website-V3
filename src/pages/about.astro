---
import Contact from '../components/Contact.astro';
import { SITE } from '../config';
import Base from '../layouts/Base.astro';

/** 技術スタック。段ごとに並べる。順番はそのまま表示の順番。 */
const STACK = [
  { name: '得意！', items: ['Unity', 'C#'] },
  {
    name: 'まあまあ',
    items: [
      'C',
      'Python',
      'Java',
      'Spring',
      'HTML/CSS',
      'Next.js',
      'Blender',
      'TypeScript',
      'Git',
      'Vim',
      'PHP',
      'SQL',
      'Supabase',
      'MongoDB',
    ],
  },
  { name: 'ちょっと', items: ['Docker', '電子工作', '作曲(Studio One)', 'イラスト'] },
];
---

<Base title="About" description={`${SITE.name} について。`}>
  <section class="shell page-head">
    <p class="mono muted">About</p>
    <h1 class="display page-head__title">Astarについて</h1>
  </section>

  <div class="shell blocks">
    <section class="block">
      <h2 class="block__label">Profile</h2>
      <div class="prose">
        <p>
          高専生です。UnityとC#が好物です。Web製作とかもやります。
        </p>
      </div>
    </section>

    <section class="block">
      <h2 class="block__label">Stack</h2>
      <div class="tiers">
        {
          STACK.map((tier, i) => (
            <div class:list={['tier', i === 0 && 'tier--core']}>
              <h3 class="tier__name">{tier.name}</h3>
              <ul class="tier__list">
                {tier.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <Contact />
  </div>
</Base>
