---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { SITE } from '../config';
import '../styles/app.css';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  ogType?: 'website' | 'article';
  /**
   * ヘッダーの現在地表示の末尾に出す文字。省くと URL の slug から作る
   * （/blog/byte-budget/ なら Byte Budget）。見出しが長い記事では
   * 題名をそのまま入れると板から溢れるので、既定のままが読みやすい。
   */
  crumb?: string | undefined;
  /** 404 のように行き先の分からないページ。現在地を ?? 1 段だけにする。 */
  notFound?: boolean | undefined;
}

const {
  title,
  description = SITE.tagline,
  ogType = 'website',
  crumb,
  notFound = false,
} = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.origin);
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    {/* 配色の指定はスタイルシートより前に置く。ブラウザが遷移中に塗る素の
        キャンバスの色はこの値で決まるので、CSS の中だけに書いていると、
        先読みが間に合わなかったときに白が一瞬出る。 */}
    <meta name="color-scheme" content="light dark" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/icon.jpg" type="image/jpeg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta name="twitter:card" content="summary" />

    {/* ホバー時に次ページを先読みする。実行 JS ではなく宣言的なヒント。
        prerender は同時に持てる数に上限があり、省電力や省メモリ、データセーバーの
        下では丸ごと無効になる。落ちたときの受け皿として prefetch も並べておく。
        1 ドキュメント = 1 リクエストなので、HTML さえ手元にあれば描画はすぐ始まる。 */}
    <script type="speculationrules" is:inline>
      {
        "prerender": [
          {
            "where": { "href_matches": "/*" },
            "eagerness": "moderate"
          }
        ],
        "prefetch": [
          {
            "where": { "href_matches": "/*" },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    {/* 背景の面。本文と同じ高さを持ち、中の方眼だけがページの 2 倍速で流れる。 */}
    <div class="deep" aria-hidden="true"></div>
    <SiteHeader crumb={crumb} notFound={notFound} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
